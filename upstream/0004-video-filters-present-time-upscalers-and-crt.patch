+    if (FILE* f = std::fopen(s_sw_capture_path, "wb")) {
+        s_sw_capture_result = png_write_rgb(f, rgb.data(), (uint32_t)ow, (uint32_t)oh) ? 1 : -1;
+        std::fclose(f);
+    }
+}
