+/* ---- Scale3x --------------------------------------------------------------- */
+static const char *VF_SCALE3X_FS =
+    VF_UP_PROLOGUE
+    VF_UP_MAIN
+    "  vec3 A=P(-1,-1), B=P(0,-1), C=P(1,-1), D=P(-1,0), E=P(0,0), F=P(1,0),\n"
