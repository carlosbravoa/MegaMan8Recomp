+    "    if (sub == ivec2(0,0) && eq(D,B)) r = D;\n"
+    "    if (sub == ivec2(1,0) && eq(B,F)) r = F;\n"
+    "    if (sub == ivec2(0,1) && eq(D,H)) r = D;\n"
