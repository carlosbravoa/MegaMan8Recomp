+void gl_renderer_video_filter_diag(int *last_kind, unsigned *broken_mask,
+                                   uint64_t *passes, uint64_t *fallbacks) {
+    if (last_kind)   *last_kind = s_vf_last_kind;
+    if (broken_mask) *broken_mask = s_vf_broken;
