+    "    if (k==2 && eq(B,F)) r = F;\n"
+    "    if (k==3 && ((eq(D,B) && !eq(E,G)) || (eq(D,H) && !eq(E,A)))) r = D;\n"
+    "    if (k==5 && ((eq(B,F) && !eq(E,I)) || (eq(H,F) && !eq(E,C)))) r = F;\n"
+    "    if (k==6 && eq(D,H)) r = D;\n"
+    "    if (k==7 && ((eq(D,H) && !eq(E,I)) || (eq(H,F) && !eq(E,G)))) r = H;\n"
